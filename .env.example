# zylos add collects credentials in Zylos .env; npm run setup supports a local checkout.
# Uncomment credential placeholders in the generated local .env only to override them.
# 默认端口，无需修改；必须与 Zylos 的 HTTP 路由一致。
WSB_PORT=47832
# 首次安装自动生成。Meta 回调页的 Verify token 填同一值。
WSB_VERIFY_TOKEN=
# 必填：同一个 Meta App → App settings → Basic → App secret。
WSB_APP_SECRET=
# 必填：WhatsApp API 测试页 → Phone number ID；不是手机号、App ID 或 WABA ID。
WSB_PHONE_NUMBER_ID=
# 收发演示必填：同一 API 测试页 → Access token；临时令牌过期后需更新。
WSB_ACCESS_TOKEN=
# Use a supported version shown in your Meta app's API testing example.
WSB_GRAPH_VERSION=v25.0

# log: receive only; echo: reply "收到：..."; c4: forward to Zylos.
WSB_MODE=c4
# Optional; defaults to ~/zylos. Keep this consistent with the running Zylos instance.
# ZYLOS_DIR=/absolute/path/to/zylos
# Optional; defaults to this project's data/ directory.
# WSB_DATA_DIR=/absolute/path/to/data
# Optional; defaults to ~/zylos/.claude/skills/comm-bridge/scripts/c4-receive.js
# WSB_C4_RECEIVE=/absolute/path/to/c4-receive.js
