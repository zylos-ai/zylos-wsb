{
  "name": "zylos-wsb",
  "version": "0.1.3",
  "private": true,
  "description": "Minimal WhatsApp Business Cloud API channel demo for Zylos",
  "type": "module",
  "engines": { "node": ">=20.20.0" },
  "scripts": {
    "setup": "node scripts/setup.js",
    "webhook": "node scripts/webhook.js",
    "check": "node scripts/check.js",
    "start": "node src/index.js",
    "demo": "node scripts/demo.js",
    "send": "node scripts/send.js",
    "check:syntax": "find src scripts test -name '*.js' -exec node --check {} +",
    "test": "node --test test/*.test.js"
  }
}
